# ===========================================================================
# Tranquil Peeplz — environment configuration
# Copy to `.env` for local development:  cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. POSTGRES (required) — one connection string for your database.
#
#    LOCAL — point at your local Postgres:
#      DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
#    HOSTED (Neon / Supabase / Railway…):
#      DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---------------------------------------------------------------------------
#    OPTION: VERCEL POSTGRES (zero-config)
#    1. Vercel Dashboard → your project → "Storage" tab → Create Database →
#       Postgres (powered by Neon) → pick a region → Create.
#    2. Click "Connect Project" — Vercel injects POSTGRES_URL for you
#       automatically; no env var needs to be set manually.
#    3. Redeploy. The app reads POSTGRES_URL automatically
#       (DATABASE_URL takes priority if both exist).
#
#    With either option, the schema + demo data auto-create on first request.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 2. SITE OWNER (required in production)
# ---------------------------------------------------------------------------

# Passcode that unlocks the /admin dashboard (approve jobs, view applicants,
# download CSV). Default is "peeplz-admin" — CHANGE IT before deploying.
ADMIN_PASSCODE=peeplz-admin

# Where applicant notifications (CSV attachments) are emailed to.
OWNER_EMAIL=contact@tranquilpeeplz.com

# Sender identity shown on outgoing emails.
EMAIL_FROM=Tranquil Peeplz <no-reply@tranquilpeeplz.com>

# ---------------------------------------------------------------------------
# 3. SMTP SETUP (email delivery)
#
#    Emails are ALWAYS stored in the `email_logs` outbox (visible in /admin)
#    even without SMTP, so nothing is lost. Configure ONE option below to
#    actually deliver them.
#
#    Option A — single URL (Gmail app password, Resend, Mailgun, SES, Zoho…):
#      SMTP_URL=smtps://user:pass@smtp.provider.com:465
#
#    Option B — individual fields:
#      SMTP_HOST=smtp.gmail.com
#      SMTP_PORT=465
#      SMTP_SECURE=true
#      SMTP_USER=you@gmail.com
#      SMTP_PASS=your-16-char-app-password
# ---------------------------------------------------------------------------
SMTP_URL=
