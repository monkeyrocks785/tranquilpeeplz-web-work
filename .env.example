# ===========================================================================
# Tranquil Peeplz — Environment Configuration
# Copy to `.env` for local development: cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. DATABASE (required) — PostgreSQL for production
# ---------------------------------------------------------------------------

# PRODUCTION (Neon/Aiven/Vercel Postgres/Supabase) — Set in Vercel project settings
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Unpooled connection (for migrations/scripts)
# DATABASE_URL_UNPOOLED=postgresql://user:password@host:port/database?sslmode=require

# LOCAL DEVELOPMENT — PostgreSQL (uncomment if using local Postgres)
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/tranquilpeeplz

# LOCAL DEVELOPMENT — SQLite fallback (no PostgreSQL needed)
# DATABASE_URL=file:./dev.db

# ---------------------------------------------------------------------------
# 2. SITE OWNER / ADMIN (required in production)
# ---------------------------------------------------------------------------

# Passcode that unlocks the /admin dashboard (approve jobs, view applicants, download CSV)
# CHANGE THIS before deploying!
ADMIN_PASSCODE=your-secure-admin-passcode-here

# Where applicant notifications (CSV attachments) are emailed to
OWNER_EMAIL=contact@yourdomain.com

# Sender identity shown on outgoing emails
EMAIL_FROM=Tranquil Peeplz <no-reply@yourdomain.com>

# Session secret for admin authentication (generate with: openssl rand -base64 32)
SESSION_SECRET=your-session-secret-here

# ---------------------------------------------------------------------------
# 3. SMTP SETUP (email delivery)
# ---------------------------------------------------------------------------

# Emails are ALWAYS stored in the `email_logs` outbox (visible in /admin)
# even without SMTP, so nothing is lost. Configure ONE option below to
# actually deliver them.

# Option A — single URL (Gmail app password, Resend, Mailgun, SES, Zoho…):
# SMTP_URL=smtps://user:pass@smtp.provider.com:465

# Option B — individual fields (Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password

# ---------------------------------------------------------------------------
# 4. OPTIONAL: External services
# ---------------------------------------------------------------------------

# Analytics / tracking (optional)
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# HOTJAR_ID=

# ---------------------------------------------------------------------------
# 5. LOCAL DEVELOPMENT OVERRIDES (do not set in production)
# ---------------------------------------------------------------------------

# Skip database bootstrap on startup (useful for testing)
# SKIP_DB_BOOTSTRAP=1

# Use SQLite for local development (set DATABASE_URL=file:./dev.db)
# This is automatic if DATABASE_URL starts with "file:"