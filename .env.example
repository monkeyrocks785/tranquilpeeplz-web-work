POSTGRES_URL_NON_POOLING=postgresql://neondb_owner:npg_edrcWqPQ58wG@ep-odd-fog-b3vgscu9.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
POSTGRES_USER=neondb_owner
