{
  "buildCommand": "npm run vercel-build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/app.css",
      "destination": "/app.css"
    },
    {
      "source": "/logo-t.png",
      "destination": "/logo-t.png"
    },
    {
      "source": "/logo-options.png",
      "destination": "/logo-options.png"
    },
    {
      "source": "/logo-options-org.png",
      "destination": "/logo-options-org.png"
    },
    {
      "source": "/fonts/(.*)",
      "destination": "/fonts/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}