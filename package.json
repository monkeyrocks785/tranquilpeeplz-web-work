{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "npm run css && tsx watch server.ts",
    "build": "npm run css",
    "start": "tsx server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "dev:turbo": "next dev",
    "css": "tailwindcss -i src/styles/app.css -o public/app.css --minify",
    "css:watch": "tailwindcss -i src/styles/app.css -o public/app.css --watch"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "express": "^5.2.1",
    "lucide-react": "^1.33.0",
    "lucide-static": "^1.34.0",
    "motion": "^13.1.1",
    "next": "^16.3.2",
    "nodemailer": "^9.0.5",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "4.1.17",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.2",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  },
  "type": "module"
}
